
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Asociación de Emprendedoras</title>

    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/Site.css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    @{
        bool autenticado = Session["Autenticado"] != null &&
                           (bool)Session["Autenticado"];
    }

    <nav class="barra-navegacion">
        <div class="container navegacion-contenido">

            <a class="nombre-asociacion"
               href="@Url.Action("Index", "Home")">
                Asociación de Emprendedoras
            </a>

            <div class="enlaces-navegacion">

                <a href="@Url.Action("Index", "Home")">Inicio</a>

                <a href="@Url.Action("Index", "Catalog")">Catálogo</a>

                @if (autenticado)
                {
                    <a href="@Url.Action("Index", "Producto")">Productos</a>

                    <a href="@Url.Action("Index", "PurchaseRequest")">Solicitudes</a>

                    <a href="@Url.Action("Logout", "Account")">Cerrar sesión</a>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")">Administración</a>
                }

            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
    </div>

    <footer class="footer-asociacion">
        <div class="container">

            <h4>Asociación de Emprendedoras</h4>

            <p>
                Impulsando el talento, la creatividad y el crecimiento
                de los emprendimientos de nuestra comunidad.
            </p>

            <hr />

            <p class="footer-derechos">
                &copy; @DateTime.Now.Year Asociación de Emprendedoras.
                Todos los derechos reservados.
            </p>

        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>
