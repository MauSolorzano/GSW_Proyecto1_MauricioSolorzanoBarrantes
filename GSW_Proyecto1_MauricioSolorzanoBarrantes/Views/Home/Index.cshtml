
@{
    ViewBag.Title = "Inicio";
}

<main class="pagina-inicio">

    <section class="presentacion">
        <h1>Bienvenidos a la Asociación de Emprendedoras</h1>

        <p>
            Un espacio para descubrir productos, apoyar el talento
            y fortalecer los emprendimientos de nuestra comunidad.
        </p>

        <a href="@Url.Action("Index", "Catalog")" class="boton-principal">
            Explorar catálogo
        </a>
    </section>

    <section class="seccion-opciones">
        <h2>Conoce nuestra plataforma</h2>

        <div class="contenedor-tarjetas">

            <article class="tarjeta-inicio">
                <h3>Catálogo de productos</h3>
                <p>
                    Descubre los productos disponibles y conoce
                    las diferentes opciones que ofrecen nuestras emprendedoras.
                </p>
                <a href="@Url.Action("Index", "Catalog")" class="boton-tarjeta">
                    Ver catálogo
                </a>
            </article>

            <article class="tarjeta-inicio">
                <h3>Solicitudes de compra</h3>
                <p>
                    Si encuentras un producto de tu interés,
                    puedes enviar una solicitud de compra fácilmente.
                </p>
                <a href="@Url.Action("Index", "Catalog")" class="boton-tarjeta">
                    Solicitar producto
                </a>
            </article>

            <article class="tarjeta-inicio">
                <h3>Administración</h3>
                <p>
                    Gestiona los productos publicados y consulta
                    las solicitudes recibidas por la asociación.
                </p>
                <a href="@Url.Action("Login", "Account")" class="boton-tarjeta">
                    Acceso administrativo
                </a>
            </article>

        </div>
    </section>

</main>
