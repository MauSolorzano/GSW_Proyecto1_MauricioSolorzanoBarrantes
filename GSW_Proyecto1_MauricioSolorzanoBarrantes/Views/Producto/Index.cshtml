
@model IEnumerable<GSW_Proyecto1_MauricioSolorzanoBarrantes.Models.Producto>

@{
    ViewBag.Title = "Gestión de productos";
}

<main class="container">

    <section>
        <header>
            <h2>Gestión de productos</h2>
            <p>Consulta y administra los productos de la asociación.</p>
        </header>

        <p>
            @Html.ActionLink(
                     "Registrar producto",
                     "Crear",
                     "Producto",
                     null,
                     new { @class = "btn btn-primary" }
                 )
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Disponibilidad</th>
                        <th>Fecha de registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var producto in Model)
                        {
                            <tr>
                                <td>@producto.Nombre</td>
                                <td>@producto.Descripcion</td>
                                <td>@producto.Precio.ToString("N2")</td>
                                <td>
                                    @if (producto.Disponible)
                                    {
                                        <span class="text-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">No disponible</span>
                                    }
                                </td>
                                <td>@producto.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @Html.ActionLink(
                                             "Editar",
                                             "Editar",
                                             new { id = producto.IdProducto },
                                             new { @class = "btn btn-warning btn-sm" }
                                         )
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">
                                No hay productos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</main>
